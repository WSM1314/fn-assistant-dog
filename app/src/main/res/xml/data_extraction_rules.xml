<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+：云备份与设备迁移一律排除，加密凭据库与 DataStore 不出本机。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
